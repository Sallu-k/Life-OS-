<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing of LifeOS leaves the phone in a backup or a phone-to-phone transfer: its storage holds the PC
     token and saved copies of private notes (journal, money, reviews). After a new phone, reinstall. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
