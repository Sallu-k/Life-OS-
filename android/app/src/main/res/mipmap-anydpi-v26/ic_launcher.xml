<?xml version="1.0" encoding="utf-8"?>
<!-- The LifeOS icon (scripts/make-icons.ps1): the artwork edge to edge, so any mask shape (OnePlus
     squircle, circle) looks right; the monochrome layer is for themed icons. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_art"/>
    <foreground android:drawable="@android:color/transparent"/>
    <monochrome android:drawable="@drawable/ic_launcher_monochrome"/>
</adaptive-icon>
