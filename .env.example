# Copy this file to .env.local and edit.
# Path to the Obsidian vault (the folder that contains Collections/, Daily/, _assets/ ...).
# Windows example (use forward slashes): VAULT_PATH=D:/Vaults/LifeOS-Vault
# Leave unset to use the fake ./sample-vault.
VAULT_PATH=./sample-vault

# Optional: free key from https://rawg.io/apidocs, used by `npm run add-game` to fetch posters.
RAWG_API_KEY=
